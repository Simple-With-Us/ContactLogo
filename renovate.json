{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "minimumReleaseAge": "5 days",
  "ignorePaths": ["**/node_modules/**", "backups/**"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "non-major dependencies",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major"]
    },
    {
      "description": "Hold TypeScript 7 until typescript-eslint supports it (peers typescript <6.1; TS 7.0 has no JS API — fleet decision).",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ],
  "vulnerabilityAlerts": { "labels": ["security"], "minimumReleaseAge": null }
}
