<?xml version="1.0" encoding="UTF-8"?>
<!-- 2026-10-17 (CL-203): entitlements for the Mac App Store / TestFlight build.
     Identical to Apps/ContactLogoMac/ContactLogoMac.entitlements except that
     the Sparkle InstallerLauncher mach-lookup exceptions are gone: this build
     does not link Sparkle, and a temporary exception is the kind of entry the
     store questions.  Keep the two files in step for everything else. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.personal-information.addressbook</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.contactlogo</string>
    </array>
</dict>
</plist>
