<?xml version="1.0" encoding="UTF-8"?>
<!-- 2026-09-22 [MM]: Added com.apple.security.application-groups carrying
     group.com.contactlogo so the macOS app shares the App Group with the
     renamed iOS app (com.contactlogo.ios).  Associated Domains are
     intentionally absent on macOS — the App Group is the only shared
     capability we need today.  See
     docs/rollouts/2026-09-22-bundle-id-migration.md. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.personal-information.addressbook</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Reading the file the user picks in the manual-override NSOpenPanel
         (per-contact override, VISION.md) requires this even though the
         panel itself is always shown — without it, Data(contentsOf:) on the
         selected URL fails under App Sandbox. -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.contactlogo</string>
    </array>
    <!-- Sparkle 2 (2026-10-15): a sandboxed app needs the InstallerLauncher
         mach-lookup exceptions or updates download but never install.  The
         launcher service registers as <bundle-id>-spks / <bundle-id>-spki.
         Requires SUEnableInstallerLauncherService=YES in Info.plist, which
         scripts/mac-release-build.sh writes. -->
    <key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
    <array>
        <string>com.contactlogo.macos-spks</string>
        <string>com.contactlogo.macos-spki</string>
    </array>
</dict>
</plist>
